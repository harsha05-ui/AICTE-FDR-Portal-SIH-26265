// AICTE Security Deposit / FDR Portal - Database Schema
// SQLite for rapid local/demo development; target production is PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Relational Models

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String
  role          String       @default("INSTITUTION_USER") // INSTITUTION_USER | REVIEWER | APPROVER | ADMIN
  designation   String?
  department    String?
  office        String?      // REGIONAL_OFFICE | APPROVAL_BUREAU | GRIEVANCE_CELL | VIGILANCE_CELL | COMPETENT_AUTHORITY
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdFdrs     FDR[]                @relation("CreatedByUser")
  documents       Document[]           @relation("UploadedByUser")
  verifications   VerificationRecord[] @relation("ReviewedByUser")
  renewalRequests RenewalRecord[]      @relation("SubmittedRenewal")
  releaseRequests ReleaseRequest[]     @relation("RequestedRelease")
  notifications   Notification[]       @relation("RecipientUser")
  auditLogs       AuditLog[]           @relation("ActorUser")

  @@index([email])
  @@index([institutionId])
  @@index([role])
}

model Institution {
  id              String   @id @default(cuid())
  institutionCode String   @unique // AICTE Permanent ID (e.g. 1-10023412)
  name            String
  address         String?
  city            String?
  state           String?
  region          String?  // Northern, Western, Southern, etc.
  type            String?  // Government, Govt-Aided, Private-Unaided, University
  contactEmail    String?
  contactPhone    String?
  principalName   String?
  status          String   @default("ACTIVE") // ACTIVE, UNDER_REVIEW, DEFAULTER
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users User[]
  fdrs  FDR[]
  holds Hold[]

  @@index([institutionCode])
  @@index([region])
  @@index([status])
}

model FDR {
  id                 String   @id @default(cuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  referenceNumber    String
  bankName           String
  branchName         String
  ifscCode           String?
  accountNumber      String?
  depositAmount      Decimal
  interestRate       Decimal  @default(7.0)
  instrumentType     String   @default("FDR") // "FDR" | "SECURITY_DEPOSIT"
  issueDate          DateTime
  maturityDate       DateTime
  verificationStatus String   @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | VERIFIED | DISCREPANCY | REJECTED
  lifecycleStatus    String   @default("ACTIVE") // ACTIVE | EXPIRING | MATURED | RENEWED | RELEASED
  riskLevel          String   @default("LOW") // LOW | MEDIUM | HIGH
  flags              String   @default("[]") // JSON string of discrepancy flags
  trustLevel         String   @default("SUBMITTED") // SUBMITTED | STAFF_VERIFIED | BANK_CONFIRMED
  trustSimulated     Boolean  @default(false)
  lienStatus         String   @default("NOT_RECORDED") // NOT_RECORDED | CLAIMED_BY_INSTITUTION | CONFIRMED_BY_STAFF | CONFIRMED_BY_BANK
  lienNote           String?
  beneficiaryName    String?  @default("Member Secretary, AICTE")
  lienConfirmedById  String?
  lienConfirmedAt    DateTime?
  jointAccount       Boolean  @default(true)
  lienMarked         Boolean  @default(true)
  autoRenewal        Boolean  @default(false)
  previousFdrId      String?
  replacementFdrId   String?
  createdBy          String
  creator            User     @relation("CreatedByUser", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents             Document[]
  verifications         VerificationRecord[]
  renewalsAsPrevious    RenewalRecord[]      @relation("PreviousFdr")
  renewalsAsReplacement RenewalRecord[]      @relation("ReplacementFdr")
  releaseRequests       ReleaseRequest[]
  notifications         Notification[]
  preSubmissionChecks   PreSubmissionCheck[]
  bankReceipts          BankReceipt[]

  @@unique([bankName, referenceNumber])
  @@index([referenceNumber])
  @@index([institutionId])
  @@index([verificationStatus])
  @@index([lifecycleStatus])
  @@index([trustLevel])
  @@index([lienStatus])
  @@index([maturityDate])
}

model Document {
  id               String              @id @default(cuid())
  fdrId            String
  fdr              FDR                 @relation(fields: [fdrId], references: [id], onDelete: Restrict)
  documentType     String              // FDR_CERTIFICATE, BANK_CONFIRMATION_LETTER, LIEN_ENDORSEMENT, INSTITUTION_REQUEST_LETTER, OTHER
  slotType         String?             // e.g. FDR_CERTIFICATE, BANK_CONFIRMATION_LETTER, LIEN_ENDORSEMENT, INSTITUTION_REQUEST_LETTER
  originalFilename String
  storageKey       String              @unique
  mimeType         String
  size             Int
  version          Int                 @default(1)
  checksum         String?
  iv               String?             // AES-256-GCM IV (hex)
  authTag          String?             // AES-256-GCM authTag (hex)
  uploadedBy       String
  uploader         User                @relation("UploadedByUser", fields: [uploadedBy], references: [id], onDelete: Restrict)
  uploadedAt       DateTime            @default(now())
  extraction       DocumentExtraction?

  @@index([fdrId])
  @@index([uploadedBy])
}

model DocumentExtraction {
  id              String   @id @default(cuid())
  documentId      String   @unique
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  method          String   // TEXT_LAYER | OCR
  extractedFields String   // JSON string
  confidence      Float    @default(1.0)
  status          String   @default("PENDING") // PENDING | DONE | FAILED
  errorMessage    String?
  fileSha256      String
  rawText         String?
  extractedAt     DateTime @default(now())

  @@index([documentId])
  @@index([status])
}

model PreSubmissionCheck {
  id           String   @id @default(cuid())
  instrumentId String
  instrument   FDR      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  checkType    String   // DOCUMENT_SLOTS | EXTRACTION | FIELD_MATCH | BANK_RECEIPT
  field        String   // referenceNumber, depositAmount, depositorName, etc.
  status       String   // MATCH | MISMATCH | NOT_FOUND | PASSED | FAILED
  details      String?  // JSON string
  simulated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([instrumentId])
  @@index([checkType])
  @@index([status])
}

model BankReceipt {
  id            String   @id @default(cuid())
  instrumentId  String
  instrument    FDR      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  receiptRef    String
  source        String   // LIVE | MOCK | MANUAL_LETTER
  simulated     Boolean  @default(false)
  payloadSha256 String
  payload       String   // JSON string
  status        String   // CONFIRMED | NOT_FOUND | MISMATCH | NOT_INTEGRATED
  receivedAt    DateTime @default(now())

  @@index([instrumentId])
  @@index([receiptRef])
  @@index([status])
}

model VerificationRecord {
  id             String   @id @default(cuid())
  fdrId          String
  fdr            FDR      @relation(fields: [fdrId], references: [id], onDelete: Restrict)
  reviewerId     String
  reviewer       User     @relation("ReviewedByUser", fields: [reviewerId], references: [id], onDelete: Restrict)
  result         String   // VERIFIED | DISCREPANCY | REJECTED
  source         String   // MANUAL_REVIEW | SFMS_CORE_BANKING | DIRECT_BANK_API
  remarks        String?
  verifiedFields String?  // JSON stringified verified parameters
  verifiedAt     DateTime @default(now())

  @@index([fdrId])
  @@index([reviewerId])
  @@index([result])
}

model RenewalRecord {
  id               String    @id @default(cuid())
  previousFdrId    String
  previousFdr      FDR       @relation("PreviousFdr", fields: [previousFdrId], references: [id], onDelete: Restrict)
  replacementFdrId String?
  replacementFdr   FDR?      @relation("ReplacementFdr", fields: [replacementFdrId], references: [id], onDelete: Restrict)
  submittedBy      String
  submitter        User      @relation("SubmittedRenewal", fields: [submittedBy], references: [id], onDelete: Restrict)
  type             String    @default("RENEWAL") // RENEWAL | REPLACEMENT
  status           String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | DECLINED
  proposedAmount   Decimal?
  proposedMaturity DateTime?
  newBankName      String?
  newBranchName    String?
  justification    String?
  remarks          String?
  reviewedBy       String?
  decisionAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([previousFdrId])
  @@index([replacementFdrId])
  @@index([status])
}

model ReleaseRequest {
  id              String    @id @default(cuid())
  fdrId           String
  fdr             FDR       @relation(fields: [fdrId], references: [id], onDelete: Restrict)
  requestedBy     String
  requester       User      @relation("RequestedRelease", fields: [requestedBy], references: [id], onDelete: Restrict)
  requestType     String    @default("RELEASE") // RELEASE | REFUND
  reason          String
  status          String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | DECLINED | COMPLETED
  amount          Decimal
  councilOrderRef String?
  reviewedBy      String?
  decision        String?
  decisionRemarks String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stages          ReleaseStage[]
  issuedOrder     IssuedOrder?

  @@index([fdrId])
  @@index([requestedBy])
  @@index([status])
}

model Notification {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("RecipientUser", fields: [userId], references: [id], onDelete: Restrict)
  fdrId          String?
  fdr            FDR?      @relation(fields: [fdrId], references: [id], onDelete: SetNull)
  type           String    // MATURITY_ALERT | VERIFICATION_UPDATE | RENEWAL_STATUS | RELEASE_STATUS | SYSTEM | ESCALATION
  thresholdDays  Int?      // 90, 60, 30, 7
  title          String
  message        String
  urgency        String    @default("NORMAL") // NORMAL | HIGH | URGENT
  dueDate        DateTime?
  sentAt         DateTime?
  readAt         DateTime?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  @@unique([fdrId, type, thresholdDays, userId])
  @@index([userId])
  @@index([fdrId])
  @@index([idempotencyKey])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actor         User?    @relation("ActorUser", fields: [actorId], references: [id], onDelete: SetNull)
  actorName     String?
  actorRole     String?
  action        String
  entityType    String   // FDR, Institution, Document, Verification, Renewal, Release, User
  entityId      String
  timestamp     DateTime @default(now())
  changeSummary String
  ipAddress     String?
  metadata      String?  // JSON stringified context (old/new JSON)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([timestamp])
}

model WorkflowHistory {
  id             String   @id @default(cuid())
  entityType     String   // FDR, RENEWAL, RELEASE, VERIFICATION
  entityId       String
  previousStatus String
  newStatus      String
  actorId        String?
  actorName      String?
  actorRole      String?
  remarks        String?
  timestamp      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
}

model BankSimulationRecord {
  id              String   @id @default(cuid())
  bankName        String
  referenceNumber String
  accountNumber   String?
  depositAmount   Decimal
  status          String   @default("CONFIRMED") // CONFIRMED | NOT_FOUND | MISMATCH
  lienMarked      Boolean  @default(true)
  beneficiaryName String   @default("Member Secretary, AICTE")
  createdAt       DateTime @default(now())

  @@unique([bankName, referenceNumber])
}

model Setting {
  key         String   @id @unique
  value       String   // JSON stringified value
  description String?
  isSample    Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model ReleaseStage {
  id               String         @id @default(cuid())
  releaseRequestId String
  releaseRequest   ReleaseRequest @relation(fields: [releaseRequestId], references: [id], onDelete: Cascade)
  office           String         // REGIONAL_OFFICE | APPROVAL_BUREAU | GRIEVANCE_CELL | VIGILANCE_CELL | COMPETENT_AUTHORITY
  order            Int
  assignedTo       String?
  status           String         @default("PENDING") // PENDING | ACTIVE | APPROVED | REJECTED | RETURNED
  remarks          String?
  dueAt            DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  actionById       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([releaseRequestId])
  @@index([office])
  @@index([status])
}

model Hold {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  reason        String
  sourceBody    String      // CBI, High Court, AICTE Vigilance, Regional Council, etc.
  referenceNo   String
  active        Boolean     @default(true)
  placedBy      String
  placedAt      DateTime    @default(now())
  clearedBy     String?
  clearedAt     DateTime?
  clearRemarks  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId])
  @@index([active])
}

model IssuedOrder {
  id               String         @id @default(cuid())
  releaseRequestId String         @unique
  releaseRequest   ReleaseRequest @relation(fields: [releaseRequestId], references: [id], onDelete: Restrict)
  type             String         // NOC | SANCTION_ORDER
  referenceNo      String         @unique // NOC/DEMO/YYYY/NNNN
  filePath         String
  issuedBy         String
  issuedAt         DateTime       @default(now())
  createdAt        DateTime       @default(now())
}


