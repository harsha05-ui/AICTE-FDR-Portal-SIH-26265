# AICTE Security Deposit / FDR Portal - Backend Environment Configuration

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aicte_fdr_db?schema=public"

# Authentication & Sessions
JWT_SECRET="aicte_statutory_portal_jwt_secret_change_in_production_2026"
JWT_REFRESH_SECRET="aicte_statutory_portal_refresh_secret_change_in_production_2026"
SESSION_COOKIE_SECRET="aicte_secure_cookie_secret_2026"
ACCESS_TOKEN_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
